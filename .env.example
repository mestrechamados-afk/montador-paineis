# Copie para .env e preencha. NUNCA versione o arquivo .env.

# Banco (docker compose cria o PostgreSQL com estes dados)
POSTGRES_DB=montador
POSTGRES_USER=montador
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Segredo das sessões (mínimo 32 caracteres aleatórios). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-segredo-aleatorio-de-64-caracteres

# 1 = cookie só por HTTPS (produção). Use 0 apenas para testar em http://localhost
COOKIE_SECURE=1

# 1 = qualquer pessoa pode criar uma empresa nova; 0 = só entra com código de convite
ALLOW_SIGNUP=1

# Porta publicada no servidor
APP_PORT=8080

# --- Banco no Supabase (use o endereço do "Session pooler" em Connect › Connection String) ---
# DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# PGSSL=require
# PGPOOL_MAX=5
# PGCA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----   # recomendado: confere o certificado do banco

# --- Uso sem docker compose (provedores como Render, Railway, Fly.io, Azure, AWS) ---
# DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require
# PGSSL=require          # require | disable
# SESSION_DAYS=14        # validade do login
# MAX_VERSIONS=50        # versões guardadas por projeto
# BODY_LIMIT=15mb        # tamanho máximo de um projeto
# SETTINGS_LIMIT=5mb     # tamanho máximo das configurações da empresa (logos)
# TRUST_PROXY=1          # 1 atrás de proxy (Render, nginx); 0 se o app ficar exposto direto

# --- Recuperação de acesso (use só quando precisar e APAGUE depois) ---
# RESET_PASSWORD_EMAIL=seu@email.com
# RESET_PASSWORD_NEW=NovaSenhaForte123
